[Unit]
Description=Smallest AI settings advisor webagent
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/webagent-smallest
Environment=PATH=/home/ec2-user/.bun/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-/opt/webagent-smallest/.env.smallest
ExecStart=/home/ec2-user/.bun/bin/bun src/cli.ts smallest :8789
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
