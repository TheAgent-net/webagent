[Unit]
Description=supermemory webagent (pack)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/webagent-supermemory
Environment=PATH=/home/ec2-user/.bun/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-/opt/webagent-supermemory/.env.supermemory
ExecStart=/home/ec2-user/.bun/bin/bun src/cli.ts serve --pack packs/supermemory :8791
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
