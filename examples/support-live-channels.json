{
  "schemaVersion": "1",
  "name": "Acme Support",
  "business": "Acme customer support",
  "instruction": "You are Acme's support assistant. Answer from the tools and knowledge you have, keep replies short and friendly, and never invent order details.",
  "action": { "provider": "demo" },
  "model": { "type": "openrouter", "config": { "model": "openai/gpt-4o-mini", "apiKeyEnv": "OPENROUTER_API_KEY" } },
  "memory": { "type": "session" },
  "guardrail": { "type": "basic" },
  "secrets": { "type": "env" },

  "_comment": "Live channels. Values ending in 'Secret' NAME a secret; the vault resolves them at build time. No credential is ever stored in this file.",

  "channels": [
    {
      "type": "slack",
      "presenter": "text",
      "config": {
        "addr": ":8080",
        "path": "/slack/events",
        "botTokenSecret": "SLACK_BOT_TOKEN",
        "signingSecretSecret": "SLACK_SIGNING_SECRET"
      }
    },
    {
      "type": "whatsapp",
      "presenter": "text",
      "config": {
        "addr": ":8081",
        "path": "/whatsapp/webhook",
        "phoneNumberId": "1234567890",
        "accessTokenSecret": "WHATSAPP_ACCESS_TOKEN",
        "appSecretSecret": "WHATSAPP_APP_SECRET",
        "verifyTokenSecret": "WHATSAPP_VERIFY_TOKEN"
      }
    },
    {
      "type": "telegram",
      "presenter": "text",
      "config": {
        "addr": ":8082",
        "path": "/telegram/webhook",
        "botTokenSecret": "TELEGRAM_BOT_TOKEN",
        "secretTokenSecret": "TELEGRAM_SECRET_TOKEN"
      }
    }
  ]
}
